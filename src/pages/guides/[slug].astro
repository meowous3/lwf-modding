---
import { getCollection, render } from 'astro:content';
import Doc from '../../layouts/Doc.astro';
import { href } from '../../lib/url';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;

// The agent protocol guide is not written for people to read as rendered
// prose — it's a protocol document meant to be copied verbatim into a coding
// agent's context, so it renders its raw Markdown source in a <pre> instead
// of going through the Content renderer every other guide uses. It has no
// rendered headings to build a per-page TOC from, so `headings` stays empty
// rather than meaningless — Toc and Sidebar already render nothing for that.
const isAgents = guide.id === 'agents';
const { Content, headings } = isAgents ? { Content: null, headings: [] } : await render(guide);
---

<Doc title={guide.data.title} description={guide.data.blurb} slug={guide.id} headings={headings}>
  {
    isAgents ? (
      <>
        <a class="btn raw-download" href={href('guides/agents.md')} download>
          Download .md
        </a>
        <pre class="raw"><code>{guide.body}</code></pre>
      </>
    ) : (
      <Content />
    )
  }
</Doc>

<style>
  .raw-download {
    margin-bottom: 1.5rem;
  }

  /* Matches `.prose pre` in src/styles/prose.css — same plaque, same code
     material — but sets its text colour directly rather than through the
     Shiki `--shiki-light`/`--shiki-dark` custom properties, which only
     rendered (highlighted) code blocks carry. */
  .raw {
    background: var(--surface);
    color: var(--ink-inverse);
    border-radius: var(--radius);
    padding: 1rem 1.15rem 1.05rem;
    margin: 0;
    max-width: 100%;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    line-height: 1.6;
    tab-size: 2;
    scrollbar-color: var(--surface-lip) transparent;
    box-shadow:
      inset 0 1px 0 var(--surface-lip),
      0 0 0 1px var(--plaque-ring),
      var(--plaque) var(--plaque) 0 var(--surface-edge);
  }

  .raw code {
    font-family: inherit;
  }
</style>
